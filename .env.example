# ==============================================================================
# PolicyIntel AI Enterprise Platform - Environment Configuration Example
# ==============================================================================
# NOTE: Copy this file to `.env` and replace the placeholder values with your
# actual configuration secrets before running the application.

# ------------------------------------------------------------------------------
# 1. Application Core Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="PolicyIntel AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
# Generate a secure key using: `openssl rand -hex 32`
SECRET_KEY="<replace_with_a_secure_random_hash_string>"

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
POSTGRES_USER="policy_user"
POSTGRES_PASSWORD="<replace_with_postgres_password>"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="policyintel_db"
# Async SQLAlchemy Connection URL
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ------------------------------------------------------------------------------
# 3. Qdrant Vector DB Settings
# ------------------------------------------------------------------------------
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME="policy_chunks"
# Keep blank for local development, or add key for cloud instances
QDRANT_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Neo4j Knowledge Graph Settings
# ------------------------------------------------------------------------------
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="<replace_with_neo4j_password>"

# ------------------------------------------------------------------------------
# 5. LLM Provider & Embedding Models
# ------------------------------------------------------------------------------
OPENAI_API_KEY="<replace_with_your_openai_api_key>"
EMBEDDING_MODEL="text-embedding-3-small"
PRIMARY_LLM_MODEL="gpt-4o"
REASONING_LLM_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 6. Pipeline & Search Tuning Params
# ------------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RRF_K_PARAMETER=60
MAX_RETRIEVED_DOCS=10
